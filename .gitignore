# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# D Store - sensitive runtime files
session.txt
data/db.json
data/*.bak
.lynk_profile/
# File database runtime yang wajib di-bundle ke Vercel agar data pengguna & katalog tersedia
!data/public-catalog.json
!data/users.json

# Temporary / debug scripts
*.cjs
extract_segment_js.py
search_chunks.py

# D Store - internal scripts (berisi credential/session logic)
scripts/

.vercel
